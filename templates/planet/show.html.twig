{% extends 'base.html.twig' %}

{% block title %}Découvrir {{ planet.name }}{% endblock %}

{% block body %}
    <h1>En savoir plus sur {{ planet.name }}</h1>

    <ul>
        <li><strong>Nom anglais:</strong> {{ planet.englishName ?? 'N/A' }}</li>
        <li><strong>Masse:</strong> {{ planet.mass ?? 'N/A' }} Kg</li>
        <li><strong>Diamètre:</strong> {{ planet.diameter ?? 'N/A' }} Km</li>
        <li><strong>Gravité:</strong> {{ planet.gravity ?? 'N/A' }} m.s-²</li>
        <li><strong>Densité:</strong> {{ planet.density ?? 'N/A' }} g.cm3</li>
        <li><strong>Température moyenne:</strong> {{ planet.meanTemperatureCelsius ?? 'N/A' }} °C</li>
        <li><strong>Demi-grand axe:</strong> {{ planet.semimajorAxis ?? 'N/A' }} Km</li>
        <li><strong>Période de révolution:</strong> {{ planet.orbitalPeriod ?? 'N/A' }} jours</li>
        {# Pas de données accessibles pour le moment pour la vitesse orbitale #}
        {# <li><strong>Vitesse orbitale:</strong> {{ planet.orbitalSpeed ?? 'N/A' }}</li> #}
        <li><strong>Nombre de Lune(s):</strong> {{ planet.moonsCount ?? 'N/A' }}</li>
        <li><strong>Découverte par:</strong> {{ planet.discoveredBy ?? 'N/A' }}</li>
        <li><strong>Date de découverte:</strong> {{ planet.discoveryDate ?? 'N/A' }}</li>
    </ul>

    <a href="{{ path('planets_list') }}">Retour à la liste des Planètes</a>
{% endblock %}