{% extends 'base.html.twig' %}

{% block title %}Voici: {{ planet.name }}{% endblock %}

{% block body %}
    <h1>En savoir plus sur {{ planet.name }}</h1>

    <ul>
        <li><strong>Nom anglais:</strong> {{ planet.englishName ?? 'N/A' }}</li>
        <li><strong>Masse:</strong> {{ planet.mass ?? 'N/A' }}</li>
        <li><strong>Diamètre:</strong> {{ planet.diameter ?? 'N/A' }}</li>
        <li><strong>Gravité:</strong> {{ planet.gravity ?? 'N/A' }}</li>
        <li><strong>Densité:</strong> {{ planet.density ?? 'N/A' }}</li>
        <li><strong>Température moyenne:</strong> {{ planet.meanTemperature ?? 'N/A' }}</li>
        <li><strong>Demi-grand axe:</strong> {{ planet.semimajorAxis ?? 'N/A' }}</li>
        <li><strong>Période de révolution:</strong> {{ planet.orbitalPeriod ?? 'N/A' }}</li>
        <li><strong>Vitesse orbitale:</strong> {{ planet.orbitalSpeed ?? 'N/A' }}</li>
        <li><strong>Nombre de Lune(s):</strong> {{ planet.moonsCount ?? 'N/A' }}</li>
        <li><strong>Découverte par:</strong> {{ planet.discoveredBy ?? 'N/A' }}</li>
        <li><strong>Date de découverte:</strong> {{ planet.discoveryDate ?? 'N/A' }}</li>
    </ul>

    <a href="{{ path('planets_list') }}">Retour à la liste des Planètes</a>
{% endblock %}