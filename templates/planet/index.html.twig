{% extends 'base.html.twig' %}

{% block title %}Les planètes de notre Système Solaire{% endblock %}

{% block body %}

<div>
    <h1>Voici les planètes du Système Solaire</h1>

    <ul>
        {% for planet in planets %}
            <li>
                <a href="{{ path('planet_show', { slug: planet.slug }) }}">
                    {{ planet.name }}
                </a>
            </li>
        {% else %}
            <li>Aucune planète trouvée</li>
        {% endfor %}
    </ul>
</div>

{% endblock %}