<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        <!-- Favicon -->
        <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}" type="image/x-icon">

        <!-- Our custom CSS for all planets 'templates/planet/index.html.twig' -->
        <link rel="stylesheet" href="{{ asset('assets/CSS/planets.css') }}">

        <!-- Our custom CSS for a planet 'templates/planet/index.html.twig' -->
        <link rel="stylesheet" href="{{ asset('assets/CSS/planet.css') }}">

    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
